@page "/"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<PageTitle>Inicio</PageTitle>

@if (Sesion.EstaLogueado)
{
    <h1>Bienvenido, @Sesion.Usuario!.NombreUsuario</h1>

    @if (Sesion.EsAdministrador)
    {
        <p>Usá el menú lateral para gestionar clientes, canchas, tipos de cancha, turnos, reservas, administradores, usuarios y reportes.</p>
    }
    else
    {
        <p class="text-muted">Desde el menú lateral podés consultar tus reservas vigentes o reservar un nuevo turno para tu deporte preferido.</p>
        <div class="d-flex gap-2 mt-4">
            <a href="mis-reservas" class="btn btn-outline-primary">Ver mis reservas</a>
            <a href="reservar-turno" class="btn btn-primary">+ Reservar un turno</a>
        </div>
    }
}

@code {
    protected override void OnInitialized()
    {
        // Sin sesión, no hay pantalla principal: al login (como el while de Program.cs del WinForms).
        if (!Sesion.EstaLogueado)
            Navigation.NavigateTo("/login");
    }
}
