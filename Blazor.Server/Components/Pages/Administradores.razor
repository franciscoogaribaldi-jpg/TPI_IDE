@page "/administradores"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Administradores</PageTitle>

<h3>Administradores</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => modal.MostrarAlta()">+ Nuevo administrador</button>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Teléfono</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!administradores.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No hay administradores para mostrar.</td></tr>
                }
                @foreach (var a in administradores)
                {
                    <tr>
                        <td>@a.IdAdministrador</td>
                        <td>@a.Nombre</td>
                        <td>@a.Apellido</td>
                        <td>@a.Telefono</td>
                        <td>@a.NombreUsuario</td>
                        <td>@a.Email</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.MostrarEdicion(a)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminarAsync(a)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<AdministradorModal @ref="modal" OnGuardado="AlGuardarAsync" />

@code {
    private List<AdministradorDTO> administradores = new();
    private bool cargando = true;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private AdministradorModal modal = null!;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EsAdministrador)
        {
            Navigation.NavigateTo(Sesion.EstaLogueado ? "/" : "/login");
            return;
        }
        await CargarTodosAsync();
    }

    private async Task CargarTodosAsync()
    {
        await EjecutarConEsperaAsync(async () =>
            administradores = (await AdministradorApiClient.GetAllAsync(Sesion.Token)).ToList());
    }

    // aviso: texto especial del modal (por ejemplo, "administrador recuperado") o null.
    private async Task AlGuardarAsync(string? aviso)
    {
        mensajeExito = aviso ?? "Administrador guardado correctamente.";
        await CargarTodosAsync();
    }

    private async Task ConfirmarEliminarAsync(AdministradorDTO a)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar a {a.Nombre} {a.Apellido}? También se elimina su usuario \"{a.NombreUsuario}\".");
        if (!confirmado) return;

        await EjecutarConEsperaAsync(async () =>
        {
            await AdministradorApiClient.DeleteAsync(a.IdAdministrador, Sesion.Token);
            administradores = (await AdministradorApiClient.GetAllAsync(Sesion.Token)).ToList();
            mensajeExito = "Administrador eliminado.";
        });
    }

    private async Task EjecutarConEsperaAsync(Func<Task> accion)
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
