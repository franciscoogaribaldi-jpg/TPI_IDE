@page "/usuarios"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<PageTitle>Usuarios</PageTitle>

<h3>Usuarios</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => modal.MostrarAlta()">+ Nuevo usuario</button>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!usuarios.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No hay usuarios para mostrar.</td></tr>
                }
                @foreach (var u in usuarios)
                {
                    <tr>
                        <td>@u.IdUsuario</td>
                        <td>@u.NombreUsuario</td>
                        <td>@u.Email</td>
                        <td>@(u.Rol == 1 ? "Administrador" : "Cliente")</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.MostrarEdicion(u)">Editar</button>
                            @if (u.IdUsuario == Sesion.IdUsuario)
                            {
                                <span class="badge bg-secondary">Tu usuario</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(u)">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<UsuarioModal @ref="modal" OnGuardado="AlGuardarAsync" />
<ConfirmacionModal @ref="modalConfirmacion" />

@code {
    private List<UsuarioDTO> usuarios = new();
    private bool cargando = true;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private UsuarioModal modal = null!;
    private ConfirmacionModal modalConfirmacion = null!;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EsAdministrador)
        {
            Navigation.NavigateTo(Sesion.EstaLogueado ? "/" : "/login");
            return;
        }
        await CargarTodosAsync();
    }

    private async Task CargarTodosAsync()
    {
        await EjecutarConEsperaAsync(async () =>
            usuarios = (await UsuarioApiClient.GetAllAsync(Sesion.Token)).ToList());
    }

    private async Task AlGuardarAsync(string? aviso)
    {
        mensajeExito = aviso ?? "Usuario guardado correctamente.";
        await CargarTodosAsync();
    }

    private void ConfirmarEliminar(UsuarioDTO u)
    {
        if (u.IdUsuario == Sesion.IdUsuario)
        {
            mensajeError = "No podés eliminarte a vos mismo: te quedarías sin acceso al sistema.";
            StateHasChanged();
            return;
        }

        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        modalConfirmacion.Mostrar(
            $"¿Eliminar el usuario \"{u.NombreUsuario}\"? Ya no va a poder iniciar sesión.",
            async () =>
            {
                await EjecutarConEsperaAsync(async () =>
                {
                    await UsuarioApiClient.DeleteAsync(u.IdUsuario, Sesion.Token);
                    usuarios = (await UsuarioApiClient.GetAllAsync(Sesion.Token)).ToList();
                    mensajeExito = "Usuario eliminado.";
                });
            },
            tituloModal: "Eliminar usuario",
            btnConfirmarTexto: "Eliminar"
        );
    }

    private async Task EjecutarConEsperaAsync(Func<Task> accion)
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
