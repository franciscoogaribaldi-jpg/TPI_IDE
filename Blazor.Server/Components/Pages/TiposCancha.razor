@page "/tipos-cancha"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Tipos de Cancha</PageTitle>

<h3>Tipos de Cancha</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => modal.MostrarAlta()">+ Nuevo tipo de cancha</button>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre / Superficie</th>
                    <th>Deporte</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!tipos.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No hay tipos de cancha para mostrar.</td></tr>
                }
                @foreach (var t in tipos)
                {
                    <tr>
                        <td>@t.IdTipoSuperficie</td>
                        <td>@t.Nombre</td>
                        <td>
                            <span class="badge @(t.Deporte == "Futbol" ? "bg-success" : "bg-warning text-dark")">
                                @t.Deporte
                            </span>
                        </td>
                        <td class="text-nowrap text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.MostrarEdicion(t)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminarAsync(t)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<TipoSuperficieModal @ref="modal" OnGuardado="AlGuardarAsync" />
<ConfirmacionModal @ref="modalConfirmacion" />

@code {
    private List<TipoSuperficieDTO> tipos = new();
    private bool cargando = true;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private TipoSuperficieModal modal = null!;
    private ConfirmacionModal modalConfirmacion = null!;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EsAdministrador)
        {
            Navigation.NavigateTo(Sesion.EstaLogueado ? "/" : "/login");
            return;
        }
        await CargarTodosAsync();
    }

    private async Task CargarTodosAsync()
    {
        await EjecutarConEsperaAsync(async () =>
            tipos = (await TipoSuperficieApiClient.GetAllAsync(Sesion.Token)).ToList());
    }

    private async Task AlGuardarAsync()
    {
        mensajeExito = "Tipo de cancha guardado correctamente.";
        await CargarTodosAsync();
    }

    private void ConfirmarEliminarAsync(TipoSuperficieDTO tipo)
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        modalConfirmacion.Mostrar(
            $"¿Eliminar el tipo de cancha '{tipo.Nombre}' ({tipo.Deporte})?",
            async () =>
            {
                await EjecutarConEsperaAsync(async () =>
                {
                    await TipoSuperficieApiClient.DeleteAsync(tipo.IdTipoSuperficie, Sesion.Token);
                    mensajeExito = "Tipo de cancha eliminado.";
                    await CargarTodosAsync();
                });
            },
            tituloModal: "Eliminar tipo de cancha",
            btnConfirmarTexto: "Eliminar"
        );
    }

    private async Task EjecutarConEsperaAsync(Func<Task> accion)
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
