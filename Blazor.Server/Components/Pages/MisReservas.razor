@page "/mis-reservas"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<PageTitle>Mis Reservas</PageTitle>

<h3>Mis reservas</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="mb-3">
    <a href="reservar-turno" class="btn btn-primary">+ Reservar nuevo turno</a>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Cancha</th>
                    <th>Turno</th>
                    <th>Estado</th>
                    <th class="text-end">Importe total</th>
                    <th class="text-end">Seña</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!reservas.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No tenés reservas registradas.</td></tr>
                }
                @foreach (var r in reservas)
                {
                    <tr>
                        <td class="text-nowrap">@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="fw-bold">@r.NombreCancha</td>
                        <td><span class="badge bg-light text-dark border">@r.HorarioTurno</span></td>
                        <td>
                            <span class="badge @BadgeColor(r.EstadoReserva)">
                                @NombreEstado(r.EstadoReserva)
                            </span>
                        </td>
                        <td class="text-end text-nowrap">@r.ImporteTotal.ToString("C2")</td>
                        <td class="text-end text-nowrap">@r.Sena.ToString("C2")</td>
                        <td class="text-nowrap text-end">
                            @if (PuedeCancelar(r))
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirModalCancelar(r)">
                                    Cancelar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarModalCancelar && reservaACancelar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Cancelar Reserva</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalCancelar" disabled="@cancelando"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">¿Estás seguro de que deseas cancelar la siguiente reserva?</p>
                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="row g-2">
                            <div class="col-4 text-muted">Fecha:</div>
                            <div class="col-8 fw-bold">@reservaACancelar.Fecha.ToString("dd/MM/yyyy")</div>

                            <div class="col-4 text-muted">Cancha:</div>
                            <div class="col-8 fw-bold">@reservaACancelar.NombreCancha</div>

                            <div class="col-4 text-muted">Horario:</div>
                            <div class="col-8"><span class="badge bg-dark">@reservaACancelar.HorarioTurno</span></div>

                            <div class="col-4 text-muted">Total:</div>
                            <div class="col-8 fw-bold">@reservaACancelar.ImporteTotal.ToString("C2")</div>
                        </div>
                    </div>
                    <p class="small text-danger mb-0">Esta acción liberará el turno para que otros clientes puedan reservarlo.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalCancelar" disabled="@cancelando">
                        Volver
                    </button>
                    <button type="button" class="btn btn-danger px-4" @onclick="ConfirmarCancelacionAsync" disabled="@cancelando">
                        @if (cancelando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Cancelando...</span>
                        }
                        else
                        {
                            <span>Sí, cancelar reserva</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ReservaDTO> reservas = new();
    private bool cargando = true;
    private bool cancelando = false;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;

    private ReservaDTO? reservaACancelar;
    private bool mostrarModalCancelar = false;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            reservas = (await ReservaApiClient.GetMisReservasAsync(Sesion.Token)).ToList();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private bool PuedeCancelar(ReservaDTO r)
    {
        return (r.EstadoReserva == 1 || r.EstadoReserva == 2) && r.Fecha.Date >= DateTime.Today;
    }

    private void AbrirModalCancelar(ReservaDTO r)
    {
        reservaACancelar = r;
        mostrarModalCancelar = true;
    }

    private void CerrarModalCancelar()
    {
        if (cancelando) return;
        mostrarModalCancelar = false;
        reservaACancelar = null;
    }

    private async Task ConfirmarCancelacionAsync()
    {
        if (reservaACancelar == null) return;

        cancelando = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        try
        {
            await ReservaApiClient.CancelarMiReservaAsync(reservaACancelar.IdReserva, Sesion.Token);
            mensajeExito = "Reserva cancelada correctamente.";
            mostrarModalCancelar = false;
            reservaACancelar = null;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            mostrarModalCancelar = false;
        }
        finally
        {
            cancelando = false;
        }
    }

    private static string NombreEstado(int estado) => estado switch
    {
        1 => "Pendiente",
        2 => "Confirmada",
        3 => "Cancelada",
        4 => "Finalizada",
        _ => estado.ToString()
    };

    private static string BadgeColor(int estado) => estado switch
    {
        1 => "bg-warning text-dark",
        2 => "bg-success",
        3 => "bg-danger",
        4 => "bg-secondary",
        _ => "bg-info"
    };
}
