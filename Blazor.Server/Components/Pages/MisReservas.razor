@page "/mis-reservas"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mis Reservas</PageTitle>

<h3>Mis reservas</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="mb-3">
    <a href="reservar-turno" class="btn btn-primary">+ Reservar nuevo turno</a>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Cancha</th>
                    <th>Turno</th>
                    <th>Estado</th>
                    <th class="text-end">Importe total</th>
                    <th class="text-end">Seña</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!reservas.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No tenés reservas registradas.</td></tr>
                }
                @foreach (var r in reservas)
                {
                    <tr>
                        <td class="text-nowrap">@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@r.NombreCancha</td>
                        <td>@r.HorarioTurno</td>
                        <td>
                            <span class="badge @BadgeColor(r.EstadoReserva)">
                                @NombreEstado(r.EstadoReserva)
                            </span>
                        </td>
                        <td class="text-end text-nowrap">@r.ImporteTotal.ToString("C2")</td>
                        <td class="text-end text-nowrap">@r.Sena.ToString("C2")</td>
                        <td class="text-nowrap text-end">
                            @if (PuedeCancelar(r))
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelarAsync(r)">
                                    Cancelar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ReservaDTO> reservas = new();
    private bool cargando = true;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            reservas = (await ReservaApiClient.GetMisReservasAsync(Sesion.Token)).ToList();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private bool PuedeCancelar(ReservaDTO r)
    {
        // 1 = Pendiente, 2 = Confirmada. Solo las no jugadas y de fecha futura o de hoy se pueden cancelar.
        return (r.EstadoReserva == 1 || r.EstadoReserva == 2) && r.Fecha.Date >= DateTime.Today;
    }

    private async Task CancelarAsync(ReservaDTO r)
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Cancelar tu reserva del {r.Fecha:dd/MM/yyyy} en {r.NombreCancha} ({r.HorarioTurno})?");
        if (!confirm) return;

        try
        {
            await ReservaApiClient.CancelarMiReservaAsync(r.IdReserva, Sesion.Token);
            mensajeExito = "Reserva cancelada correctamente.";
            await CargarAsync();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private static string NombreEstado(int estado) => estado switch
    {
        1 => "Pendiente",
        2 => "Confirmada",
        3 => "Cancelada",
        4 => "Finalizada",
        _ => estado.ToString()
    };

    private static string BadgeColor(int estado) => estado switch
    {
        1 => "bg-warning text-dark",
        2 => "bg-success",
        3 => "bg-danger",
        4 => "bg-secondary",
        _ => "bg-info"
    };
}
