@page "/clientes"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<PageTitle>Clientes</PageTitle>

<h3>Clientes</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" placeholder="Buscar por nombre, apellido o DNI..." @bind="textoBusqueda" />
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" @onclick="BuscarAsync">Buscar</button>
        <button class="btn btn-outline-secondary" @onclick="MostrarTodosAsync">Mostrar todos</button>
    </div>
    <div class="col-auto ms-auto">
        <button class="btn btn-primary" @onclick="() => modal.MostrarAlta()">+ Nuevo cliente</button>
    </div>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>DNI</th>
                    <th>Teléfono</th>
                    <th>F. Nacimiento</th>
                    <th>Usuario</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!clientes.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No hay clientes para mostrar.</td></tr>
                }
                @foreach (var c in clientes)
                {
                    <tr>
                        <td>@c.IdCliente</td>
                        <td>@c.Nombre</td>
                        <td>@c.Apellido</td>
                        <td>@c.Dni</td>
                        <td>@c.Telefono</td>
                        <td>@c.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td>@c.NombreUsuario</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.MostrarEdicion(c)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminar(c)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ClienteModal @ref="modal" OnGuardado="AlGuardarAsync" />
<ConfirmacionModal @ref="modalConfirmacion" />

@code {
    private List<ClienteDTO> clientes = new();
    private bool cargando = true;
    private string textoBusqueda = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private ClienteModal modal = null!;
    private ConfirmacionModal modalConfirmacion = null!;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EsAdministrador)
        {
            Navigation.NavigateTo(Sesion.EstaLogueado ? "/" : "/login");
            return;
        }
        await CargarTodosAsync();
    }

    private async Task CargarTodosAsync()
    {
        await EjecutarConEsperaAsync(async () =>
            clientes = (await ClienteApiClient.GetAllAsync(Sesion.Token)).ToList());
    }

    private async Task BuscarAsync()
    {
        mensajeExito = string.Empty;
        await EjecutarConEsperaAsync(async () =>
            clientes = (await ClienteApiClient.BuscarAsync(textoBusqueda.Trim(), Sesion.Token)).ToList());
    }

    private async Task MostrarTodosAsync()
    {
        textoBusqueda = string.Empty;
        mensajeExito = string.Empty;
        await CargarTodosAsync();
    }

    private async Task AlGuardarAsync(string? aviso)
    {
        mensajeExito = aviso ?? "Cliente guardado correctamente.";
        await CargarTodosAsync();
    }

    private void ConfirmarEliminar(ClienteDTO c)
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        modalConfirmacion.Mostrar(
            $"¿Eliminar a {c.Nombre} {c.Apellido} (DNI {c.Dni})?",
            async () =>
            {
                await EjecutarConEsperaAsync(async () =>
                {
                    await ClienteApiClient.DeleteAsync(c.IdCliente, Sesion.Token);
                    clientes = (await ClienteApiClient.GetAllAsync(Sesion.Token)).ToList();
                    mensajeExito = "Cliente eliminado.";
                });
            },
            tituloModal: "Eliminar cliente",
            btnConfirmarTexto: "Eliminar"
        );
    }

    private async Task EjecutarConEsperaAsync(Func<Task> accion)
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
