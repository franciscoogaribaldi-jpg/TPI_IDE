@page "/reservar-turno"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation

<PageTitle>Reservar Turno</PageTitle>

<h3>Reservar Turno</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        @mensajeExito
        <a href="mis-reservas" class="alert-link ms-2">Ir a Mis Reservas</a>
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="card p-3 mb-4 shadow-sm">
    <div class="row align-items-end g-3">
        <div class="col-12 col-md-4">
            <label class="form-label fw-bold">Fecha de reserva</label>
            <input type="date" class="form-control" @bind="fecha" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-3">
            <button class="btn btn-primary w-100" @onclick="BuscarTurnosAsync" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Buscar turnos libres
            </button>
        </div>
        <div class="col-12 col-md-5 text-md-end text-muted small">
            @lblResultado
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center my-4">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Cancha</th>
                    <th>Deporte / Tipo</th>
                    <th>Características</th>
                    <th>Horario</th>
                    <th class="text-end">Precio p/Hora</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!turnosLibres.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No hay turnos disponibles para la fecha elegida.</td></tr>
                }
                @foreach (var t in turnosLibres)
                {
                    <tr>
                        <td class="fw-bold">@t.NombreCancha</td>
                        <td>
                            <span class="badge @(t.TipoCancha == "Padel" ? "bg-warning text-dark" : "bg-success")">
                                @t.TipoCancha
                            </span>
                        </td>
                        <td>@t.Caracteristicas</td>
                        <td><span class="badge bg-light text-dark border">@t.Horario</span></td>
                        <td class="text-end text-nowrap">@t.PrecioPorHora.ToString("C2")</td>
                        <td class="text-nowrap text-end">
                            <button class="btn btn-sm btn-success" disabled="@reservando" @onclick="() => AbrirConfirmacion(t)">
                                Reservar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarModalConfirmacion && turnoSeleccionado != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Confirmar Reserva de Turno</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarConfirmacion" disabled="@reservando"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">¿Deseas confirmar la siguiente reserva?</p>
                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="row g-2">
                            <div class="col-4 text-muted">Cancha:</div>
                            <div class="col-8 fw-bold">@turnoSeleccionado.NombreCancha</div>

                            <div class="col-4 text-muted">Deporte / Tipo:</div>
                            <div class="col-8">
                                <span class="badge @(turnoSeleccionado.TipoCancha == "Padel" ? "bg-warning text-dark" : "bg-success")">
                                    @turnoSeleccionado.TipoCancha
                                </span>
                                <span class="ms-1 small text-muted">@turnoSeleccionado.Caracteristicas</span>
                            </div>

                            <div class="col-4 text-muted">Fecha:</div>
                            <div class="col-8 fw-bold">@fecha.ToString("dd/MM/yyyy")</div>

                            <div class="col-4 text-muted">Horario:</div>
                            <div class="col-8">
                                <span class="badge bg-dark">@turnoSeleccionado.Horario</span>
                            </div>

                            <div class="col-12"><hr class="my-2" /></div>

                            <div class="col-6 fw-bold">Total a abonar:</div>
                            <div class="col-6 text-end fw-bold fs-5 text-success">@turnoSeleccionado.PrecioPorHora.ToString("C2")</div>
                        </div>
                    </div>
                    <div class="small text-muted">
                        Podrás ver y gestionar tu reserva en <strong>Mis Reservas</strong>.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarConfirmacion" disabled="@reservando">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-success px-4" @onclick="ConfirmarReservaAsync" disabled="@reservando">
                        @if (reservando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Reservando...</span>
                        }
                        else
                        {
                            <span>Aceptar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime fecha = DateTime.Today.AddDays(1);
    private List<TurnoLibreDTO> turnosLibres = new();
    private bool cargando = false;
    private bool reservando = false;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private string lblResultado = string.Empty;

    private TurnoLibreDTO? turnoSeleccionado;
    private bool mostrarModalConfirmacion = false;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await BuscarTurnosAsync();
    }

    private async Task BuscarTurnosAsync()
    {
        cargando = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        try
        {
            turnosLibres = (await ReservaApiClient.GetTurnosLibresAsync(fecha, Sesion.Token)).ToList();
            lblResultado = turnosLibres.Count == 0
                ? "No hay turnos libres en esa fecha."
                : $"{turnosLibres.Count} turno(s) libre(s) para el {fecha:dd/MM/yyyy}.";
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirConfirmacion(TurnoLibreDTO turno)
    {
        turnoSeleccionado = turno;
        mostrarModalConfirmacion = true;
    }

    private void CerrarConfirmacion()
    {
        if (reservando) return;
        mostrarModalConfirmacion = false;
        turnoSeleccionado = null;
    }

    private async Task ConfirmarReservaAsync()
    {
        if (turnoSeleccionado == null) return;

        reservando = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        try
        {
            await ReservaApiClient.ReservarAsync(turnoSeleccionado.IdCancha, turnoSeleccionado.IdTurno, fecha, Sesion.Token);
            mensajeExito = $"¡Reserva registrada con éxito para {turnoSeleccionado.NombreCancha} ({turnoSeleccionado.Horario})!";
            mostrarModalConfirmacion = false;
            turnoSeleccionado = null;
            await BuscarTurnosAsync();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            mostrarModalConfirmacion = false;
        }
        finally
        {
            reservando = false;
        }
    }
}
