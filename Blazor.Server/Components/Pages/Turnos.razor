@page "/turnos"
@inject SesionUsuario Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Turnos</PageTitle>

<h3>Turnos</h3>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => modal.MostrarAlta()">+ Nuevo turno</button>
</div>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Hora inicio</th>
                    <th>Hora fin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!turnos.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No hay turnos para mostrar.</td></tr>
                }
                @foreach (var t in turnos)
                {
                    <tr>
                        <td>@t.IdTurno</td>
                        <td>@HoraCorta(t.HoraInicio)</td>
                        <td>@HoraCorta(t.HoraFin)</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.MostrarEdicion(t)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminarAsync(t)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<TurnoModal @ref="modal" OnGuardado="AlGuardarAsync" />

@code {
    private List<TurnoDTO> turnos = new();
    private bool cargando = true;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private TurnoModal modal = null!;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.EsAdministrador)
        {
            Navigation.NavigateTo(Sesion.EstaLogueado ? "/" : "/login");
            return;
        }
        await CargarTodosAsync();
    }

    // "08:00:00" -> "08:00"
    private static string HoraCorta(string hora) => hora.Length >= 5 ? hora[..5] : hora;

    private async Task CargarTodosAsync()
    {
        await EjecutarConEsperaAsync(async () =>
            turnos = (await TurnoApiClient.GetAllAsync(Sesion.Token)).OrderBy(t => t.HoraInicio).ToList());
    }

    private async Task AlGuardarAsync()
    {
        mensajeExito = "Turno guardado correctamente.";
        await CargarTodosAsync();
    }

    private async Task ConfirmarEliminarAsync(TurnoDTO t)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el turno de {HoraCorta(t.HoraInicio)} a {HoraCorta(t.HoraFin)}?");
        if (!confirmado) return;

        await EjecutarConEsperaAsync(async () =>
        {
            await TurnoApiClient.DeleteAsync(t.IdTurno, Sesion.Token);
            turnos = (await TurnoApiClient.GetAllAsync(Sesion.Token)).OrderBy(x => x.HoraInicio).ToList();
            mensajeExito = "Turno eliminado.";
        });
    }

    private async Task EjecutarConEsperaAsync(Func<Task> accion)
    {
        cargando = true;
        mensajeError = string.Empty;
        try
        {
            await accion();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
