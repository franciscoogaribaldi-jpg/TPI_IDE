@inject SesionUsuario Sesion
@if (visible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(esAlta ? "Nueva cancha" : "Editar cancha")</h5>
                    <button type="button" class="btn-close" @onclick="Cerrar"></button>
                </div>

                <EditForm Model="cancha" OnSubmit="GuardarAsync">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="cancha.Nombre" />
                            <div class="text-danger small">@Error("Nombre")</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block">Tipo de cancha</label>
                            <InputRadioGroup @bind-Value="cancha.TipoCancha">
                                <div class="form-check form-check-inline">
                                    <InputRadio class="form-check-input" Value="@("Futbol")" disabled="@(!esAlta)" />
                                    <label class="form-check-label">Fútbol</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <InputRadio class="form-check-input" Value="@("Padel")" disabled="@(!esAlta)" />
                                    <label class="form-check-label">Pádel</label>
                                </div>
                            </InputRadioGroup>
                            @if (!esAlta)
                            {
                                <div class="form-text">El tipo no se puede cambiar en una cancha ya creada.</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Precio por hora *</label>
                            <InputNumber class="form-control" @bind-Value="cancha.PrecioPorHora" step="0.01" />
                            <div class="text-danger small">@Error("PrecioPorHora")</div>
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" id="chkTechada" @bind-Value="cancha.EsTechada" />
                            <label class="form-check-label" for="chkTechada">Cancha techada</label>
                        </div>

                        @* Cada tipo de cancha muestra solo sus datos propios. Los valores son los int de los enums de Domain.Model. *@
                        @if (EsPadel)
                        {
                            <div class="mb-3">
                                <label class="form-label">Paredes *</label>
                                <InputSelect class="form-select" @bind-Value="cancha.TipoPared">
                                    <option value="1">Vidrio</option>
                                    <option value="2">Muro</option>
                                </InputSelect>
                                <div class="text-danger small">@Error("TipoPared")</div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Tipo de fútbol *</label>
                                <InputSelect class="form-select" @bind-Value="cancha.TipoFutbol">
                                    <option value="5">Fútbol 5</option>
                                    <option value="7">Fútbol 7</option>
                                    <option value="11">Fútbol 11</option>
                                </InputSelect>
                                <div class="text-danger small">@Error("TipoFutbol")</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Superficie *</label>
                                <InputSelect class="form-select" @bind-Value="cancha.TipoSuperficie">
                                    <option value="1">Césped sintético</option>
                                    <option value="2">Césped natural</option>
                                    <option value="3">Cemento</option>
                                </InputSelect>
                                <div class="text-danger small">@Error("TipoSuperficie")</div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnGuardado { get; set; }

    private bool visible;
    private bool esAlta;
    private bool guardando;
    private string mensajeError = string.Empty;
    private CanchaDTO cancha = new();
    private Dictionary<string, string> errores = new();

    private bool EsPadel => cancha.TipoCancha == "Padel";

    public void MostrarAlta()
    {
        esAlta = true;
        // Se precargan valores válidos para los dos tipos, así al cambiar de Fútbol a Pádel el combo ya tiene algo elegido.
        cancha = new CanchaDTO { Nombre = "", TipoCancha = "Futbol", Estado = 1, TipoFutbol = 5, TipoSuperficie = 1, TipoPared = 1 };
        Abrir();
    }

    public void MostrarEdicion(CanchaDTO original)
    {
        esAlta = false;
        cancha = new CanchaDTO
        {
            IdCancha = original.IdCancha,
            Nombre = original.Nombre,
            Estado = original.Estado,
            PrecioPorHora = original.PrecioPorHora,
            TipoCancha = original.TipoCancha,
            EsTechada = original.EsTechada,
            TipoFutbol = original.TipoFutbol,
            TipoSuperficie = original.TipoSuperficie,
            TipoPared = original.TipoPared
        };
        Abrir();
    }

    private void Abrir()
    {
        errores.Clear();
        mensajeError = string.Empty;
        visible = true;
        StateHasChanged();
    }

    private void Cerrar() => visible = false;

    private string? Error(string campo) => errores.GetValueOrDefault(campo);

    private bool Validar()
    {
        errores.Clear();
        if (string.IsNullOrWhiteSpace(cancha.Nombre)) errores["Nombre"] = "El nombre es obligatorio.";
        if (cancha.PrecioPorHora <= 0) errores["PrecioPorHora"] = "El precio por hora debe ser mayor a cero.";
        if (EsPadel && cancha.TipoPared == null) errores["TipoPared"] = "Elegí el tipo de pared.";
        if (!EsPadel && cancha.TipoFutbol == null) errores["TipoFutbol"] = "Elegí si es fútbol 5, 7 u 11.";
        if (!EsPadel && cancha.TipoSuperficie == null) errores["TipoSuperficie"] = "Elegí la superficie.";
        return errores.Count == 0;
    }

    private async Task GuardarAsync()
    {
        if (!Validar()) return;

        var dto = new CanchaDTO
        {
            IdCancha = cancha.IdCancha,
            Nombre = cancha.Nombre.Trim(),
            Estado = cancha.Estado,
            PrecioPorHora = cancha.PrecioPorHora,
            TipoCancha = EsPadel ? "Padel" : "Futbol",
            EsTechada = cancha.EsTechada,
            TipoFutbol = EsPadel ? null : cancha.TipoFutbol,
            TipoSuperficie = EsPadel ? null : cancha.TipoSuperficie,
            TipoPared = EsPadel ? cancha.TipoPared : null
        };

        guardando = true;
        mensajeError = string.Empty;
        try
        {
            if (esAlta) await CanchaApiClient.AddAsync(dto,Sesion.Token);
            else await CanchaApiClient.UpdateAsync(dto,Sesion.Token);

            visible = false;
            await OnGuardado.InvokeAsync();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}